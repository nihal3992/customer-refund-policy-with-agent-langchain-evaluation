# Live agent: choose an ID supported by your provider.
AGENT_MODEL=gpt-4.1-mini
AGENT_MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Web session. Use a long random value outside local development.
SESSION_SECRET=replace-with-a-random-secret
SESSION_COOKIE_SECURE=false
APP_ENV=development

# DeepEval judge (separate configuration from the agent).
EVAL_MODEL=gpt-4.1-mini
